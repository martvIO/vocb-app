<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vocb.App.Views.StudyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Study" FontSize="28" FontWeight="SemiBold" />

        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12" Padding="24" VerticalAlignment="Center">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <TextBlock x:ConnectionId='7' x:Name="PromptText" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <StackPanel x:ConnectionId='8' x:Name="AnswerPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:ConnectionId='10' x:Name="DefinitionText" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:ConnectionId='11' x:Name="ExampleText" TextWrapping="Wrap" FontStyle="Italic" Foreground="Gray"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
                <TextBlock x:ConnectionId='9' x:Name="StatusText" Foreground="Gray" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button x:ConnectionId='2' x:Name="RevealButton" Content="Show answer"                      />
            <Button x:ConnectionId='3' x:Name="AgainButton" Content="Again"                     Tag="1" Visibility="Collapsed" />
            <Button x:ConnectionId='4' x:Name="HardButton" Content="Hard"                     Tag="3" Visibility="Collapsed" />
            <Button x:ConnectionId='5' x:Name="GoodButton" Content="Good"                     Tag="4" Visibility="Collapsed" />
            <Button x:ConnectionId='6' x:Name="EasyButton" Content="Easy"                     Tag="5" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>

