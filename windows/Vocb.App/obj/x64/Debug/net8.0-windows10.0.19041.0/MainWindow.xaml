<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Vocb.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Vocb">

    <controls:NavigationView x:ConnectionId='2' x:Name="Nav"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                                                                    >
        <controls:NavigationView.MenuItems>
            <controls:NavigationViewItem Content="Words" Tag="words" IsSelected="True" />
            <controls:NavigationViewItem Content="Study" Tag="study" />
        </controls:NavigationView.MenuItems>
        <controls:NavigationView.FooterMenuItems>
            <controls:NavigationViewItem Content="Settings" Tag="settings" />
        </controls:NavigationView.FooterMenuItems>

        <Frame x:ConnectionId='3' x:Name="ContentFrame" />
    </controls:NavigationView>
</Window>

