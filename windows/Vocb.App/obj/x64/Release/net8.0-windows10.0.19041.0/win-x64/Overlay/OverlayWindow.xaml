<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Vocb.App.Overlay.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:ConnectionId='5' x:Name="WordText" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:ConnectionId='6' x:Name="PhoneticText" Foreground="Gray" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:ConnectionId='2' x:Name="DefinitionText" TextWrapping="Wrap" />
            <TextBlock x:ConnectionId='3' x:Name="ExampleText" TextWrapping="Wrap" FontStyle="Italic" Foreground="Gray" />
            <TextBlock x:ConnectionId='4' x:Name="CountText" FontSize="12" Foreground="Gray" />
        </StackPanel>
    </Border>
</Window>

