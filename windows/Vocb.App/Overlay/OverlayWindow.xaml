<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Vocb.App.Overlay.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="RootBorder"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Spacing="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Name="WordText" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="PhoneticText" Foreground="Gray" VerticalAlignment="Bottom" />
                </StackPanel>

                <Button x:Name="SpeakButton" Grid.Column="1" Click="Speak_Click"
                        Background="Transparent" BorderThickness="0" Padding="6"
                        ToolTipService.ToolTip="Pronounce">
                    <FontIcon Glyph="&#xE767;" FontSize="16" />
                </Button>

                <Button x:Name="CloseButton" Grid.Column="2" Click="Close_Click"
                        Background="Transparent" BorderThickness="0" Padding="6"
                        ToolTipService.ToolTip="Close">
                    <FontIcon Glyph="&#xE711;" FontSize="16" />
                </Button>
            </Grid>

            <TextBlock x:Name="DefinitionText" TextWrapping="Wrap" />
            <TextBlock x:Name="ExampleText" TextWrapping="Wrap" FontStyle="Italic" Foreground="Gray" />
            <TextBlock x:Name="CountText" FontSize="12" Foreground="Gray" />
        </StackPanel>
    </Border>
</Window>
