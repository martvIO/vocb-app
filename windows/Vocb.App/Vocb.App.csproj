<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WinUI 3 desktop app (unpackaged, so it can run as a background tray app).
    Requires the Windows App SDK to build: `winget install Microsoft.WindowsAppRuntime`
    plus the NuGet packages below restore on first build. Cannot be built on a
    machine without the Windows App SDK / Windows 10 SDK — authored for that target.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Vocb.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vocb.Core\Vocb.Core.csproj" />
    <ProjectReference Include="..\Vocb.Firebase\Vocb.Firebase.csproj" />
  </ItemGroup>

</Project>
