<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Vocb.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Vocb">

    <Grid>
        <!-- Shown briefly on launch while we try to restore a saved session. -->
        <ProgressRing x:Name="LoadingRing" IsActive="True" Width="48" Height="48"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Signed-out: the login screen. -->
        <Frame x:Name="LoginFrame" Visibility="Collapsed" />

        <!-- Signed-in: the app shell. -->
        <controls:NavigationView x:Name="Nav"
                                 Visibility="Collapsed"
                                 IsBackButtonVisible="Collapsed"
                                 IsSettingsVisible="False"
                                 SelectionChanged="Nav_SelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem x:Name="WordsItem" Content="Words" Tag="words" />
                <controls:NavigationViewItem Content="Study" Tag="study" />
            </controls:NavigationView.MenuItems>
            <controls:NavigationView.FooterMenuItems>
                <controls:NavigationViewItem Content="Settings" Tag="settings" />
            </controls:NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </controls:NavigationView>
    </Grid>
</Window>
