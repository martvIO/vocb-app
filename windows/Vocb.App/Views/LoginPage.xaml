<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vocb.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" Spacing="12">
            <TextBlock Text="Vocb" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Sign in to sync your vocabulary" Foreground="Gray" HorizontalAlignment="Center" />

            <TextBox x:Name="EmailBox" Header="Email" />
            <PasswordBox x:Name="PasswordBox" Header="Password" />

            <Button x:Name="SignInButton" Content="Sign in" Click="SignIn_Click"
                    Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
            <Button x:Name="CreateButton" Content="Create account" Click="Create_Click"
                    HorizontalAlignment="Stretch" />
            <HyperlinkButton x:Name="ForgotButton" Content="Forgot password?" Click="Forgot_Click"
                             HorizontalAlignment="Center" />

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False" />
        </StackPanel>
    </Grid>
</Page>
