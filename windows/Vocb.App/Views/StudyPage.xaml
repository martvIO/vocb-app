<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vocb.App.Views.StudyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Study" FontSize="28" FontWeight="SemiBold" />

        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12" Padding="24" VerticalAlignment="Center">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <TextBlock x:Name="PromptText" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <StackPanel x:Name="AnswerPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="DefinitionText" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="ExampleText" TextWrapping="Wrap" FontStyle="Italic" Foreground="Gray"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="Gray" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button x:Name="RevealButton" Content="Show answer" Click="Reveal_Click" />
            <Button x:Name="AgainButton" Content="Again" Click="Grade_Click" Tag="1" Visibility="Collapsed" />
            <Button x:Name="HardButton" Content="Hard" Click="Grade_Click" Tag="3" Visibility="Collapsed" />
            <Button x:Name="GoodButton" Content="Good" Click="Grade_Click" Tag="4" Visibility="Collapsed" />
            <Button x:Name="EasyButton" Content="Easy" Click="Grade_Click" Tag="5" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
