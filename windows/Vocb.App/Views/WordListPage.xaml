<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vocb.App.Views.WordListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Vocb.Core">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Words" FontSize="28" FontWeight="SemiBold" />

        <InfoBar Grid.Row="1" x:Name="FirstRunHint" IsOpen="False" IsClosable="True"
                 Severity="Informational" Title="Quick tip"
                 Message="Select text in any app and press Ctrl+Shift+L to look it up — it's saved here."
                 CloseButtonClick="FirstRunHint_Closed" />

        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="Gray" />

        <ListView Grid.Row="3" x:Name="WordsList">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:WordEntry">
                    <Grid ColumnSpacing="12" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Bind Text}" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="{x:Bind LearnerDefinition}" TextWrapping="Wrap" Foreground="Gray" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Padding="6"
                                Click="Speak_Click" Tag="{x:Bind}"
                                ToolTipService.ToolTip="Pronounce">
                            <FontIcon Glyph="&#xE767;" FontSize="16" />
                        </Button>
                        <Border Grid.Column="2" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="10" Padding="8,2">
                            <TextBlock Text="{x:Bind LookupCount}" Foreground="White" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
