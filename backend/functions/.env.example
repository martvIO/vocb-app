# Optional: override the Claude model used for generation.
# Defaults to claude-haiku-4-5 (fast/cheap). For higher quality try
# claude-sonnet-4-6 or claude-opus-4-8. Copy this file to `.env` to use locally.
VOCAB_MODEL=claude-haiku-4-5

# NOTE: ANTHROPIC_API_KEY is NOT set here. It is a Functions *secret*, set with:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
# (stored in Google Secret Manager, never committed).
